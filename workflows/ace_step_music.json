{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ace_step_v1_3.5b.safetensors"
    },
    "_meta": {
      "title": "Load ACE-Step 1.0 (Apache-2.0)"
    }
  },
  "2": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["1", 0],
      "shift": 5.0
    },
    "_meta": {
      "title": "ModelSamplingSD3"
    }
  },
  "3": {
    "class_type": "TextEncodeAceStepAudio",
    "inputs": {
      "clip": ["1", 1],
      "tags": "cinematic, orchestral, instrumental",
      "lyrics": "[instrumental]",
      "lyrics_strength": 0.99
    },
    "_meta": {
      "title": "Music style tags"
    }
  },
  "4": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["3", 0]
    },
    "_meta": {
      "title": "Negative (zeroed)"
    }
  },
  "5": {
    "class_type": "EmptyAceStepLatentAudio",
    "inputs": {
      "seconds": 120.0,
      "batch_size": 1
    },
    "_meta": {
      "title": "Track length"
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 50,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": {
      "title": "KSampler"
    }
  },
  "7": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    },
    "_meta": {
      "title": "VAEDecodeAudio"
    }
  },
  "8": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": ["7", 0],
      "filename_prefix": "buzzedit_audio/music"
    },
    "_meta": {
      "title": "SaveAudio"
    }
  }
}
