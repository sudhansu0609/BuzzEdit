{
  "z_unet": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "fp8_e4m3fn"}
  },
  "z_clip": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}
  },
  "z_vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "ae.safetensors"}
  },
  "z_shift": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {"model": ["z_unet", 0], "shift": 3}
  },
  "z_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {"clip": ["z_clip", 0], "text": "a cinematic photograph"}
  },
  "z_neg": {
    "class_type": "ConditioningZeroOut",
    "inputs": {"conditioning": ["z_pos", 0]}
  },
  "z_latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {"width": 832, "height": 480, "batch_size": 1}
  },
  "z_sample": {
    "class_type": "KSampler",
    "inputs": {"model": ["z_shift", 0], "positive": ["z_pos", 0], "negative": ["z_neg", 0],
               "latent_image": ["z_latent", 0], "seed": 42, "steps": 8, "cfg": 1,
               "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 1}
  },
  "z_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["z_sample", 0], "vae": ["z_vae", 0]}
  },

  "w_clip": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "w_vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "w_unet_high": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {"unet_name": "wan2.2_i2v_high_noise_14B_Q4_K_S.gguf"}
  },
  "w_lora_high": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {"model": ["w_unet_high", 0],
               "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
               "strength_model": 1.0}
  },
  "w_shift_high": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["w_lora_high", 0], "shift": 5.0}
  },
  "w_unet_low": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {"unet_name": "wan2.2_i2v_low_noise_14B_Q4_K_S.gguf"}
  },
  "w_lora_low": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {"model": ["w_unet_low", 0],
               "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
               "strength_model": 1.0}
  },
  "w_shift_low": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["w_lora_low", 0], "shift": 5.0}
  },
  "w_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {"clip": ["w_clip", 0], "text": "gentle cinematic camera movement"}
  },
  "w_neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {"clip": ["w_clip", 0], "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走, watermark, text, logo"}
  },
  "w_i2v": {
    "class_type": "WanImageToVideo",
    "inputs": {"positive": ["w_pos", 0], "negative": ["w_neg", 0], "vae": ["w_vae", 0],
               "width": 832, "height": 480, "length": 81, "batch_size": 1,
               "start_image": ["z_decode", 0]}
  },
  "w_sample_high": {
    "class_type": "KSamplerAdvanced",
    "inputs": {"model": ["w_shift_high", 0], "add_noise": "enable", "noise_seed": 42,
               "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple",
               "positive": ["w_i2v", 0], "negative": ["w_i2v", 1],
               "latent_image": ["w_i2v", 2],
               "start_at_step": 0, "end_at_step": 2, "return_with_leftover_noise": "enable"}
  },
  "w_sample_low": {
    "class_type": "KSamplerAdvanced",
    "inputs": {"model": ["w_shift_low", 0], "add_noise": "disable", "noise_seed": 42,
               "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple",
               "positive": ["w_i2v", 0], "negative": ["w_i2v", 1],
               "latent_image": ["w_sample_high", 0],
               "start_at_step": 2, "end_at_step": 4, "return_with_leftover_noise": "disable"}
  },
  "w_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["w_sample_low", 0], "vae": ["w_vae", 0]}
  },
  "up_model": {
    "class_type": "UpscaleModelLoader",
    "inputs": {"model_name": "RealESRGAN_x2plus.pth"}
  },
  "up_frames": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {"upscale_model": ["up_model", 0], "image": ["w_decode", 0]}
  },
  "v_create": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["up_frames", 0], "fps": 16.0}
  },
  "v_save": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["v_create", 0], "filename_prefix": "buzzedit_broll",
               "format": "mp4", "codec": "h264"}
  }
}
