{
  "name": "buzzcaf-editor",
  "version": "1.0.0",
  "description": "AI-Powered Automated Video Editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "start": "START_APP.bat",
    "start:all": "START_APP.bat",
    "dev:react": "vite",

    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev:backend": "cd backend && python main.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.buzzcaf.editor",
    "productName": "Buzzcaf Editor",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "workflows/**/*",
      "requirements.txt"
    ]
  }
}
