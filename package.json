{
  "name": "buzzedit",
  "version": "1.0.0",
  "description": "AI-Powered Automated Video Editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "START_APP.bat --console",
    "start:silent": "START_APP.bat",
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:backend": "cd backend && python main.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "test:ports": "node --test scripts/buzzcaf-ports.test.mjs scripts/port-plan.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "playwright": "^1.62.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.buzzedit.app",
    "productName": "BuzzEdit",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/buzzcaf-ports.mjs",
      "backend/**/*",
      "workflows/**/*",
      "requirements.txt"
    ]
  }
}
